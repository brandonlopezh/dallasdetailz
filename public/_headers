/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Public media isn't fingerprinted, so cache for a week and let browsers
# refresh in the background. Rename the file if a change must show instantly.
/hero-reel.mp4
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/hero-reel-poster.jpg
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/wallpaper.webp
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/service-area-map.webp
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
/logo.jpg
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
