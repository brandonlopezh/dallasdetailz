# Copy to .env.local and fill in. All free-tier services.

# --- Supabase (free tier) -------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 1 integrations (optional until wired) --------------------------
# Google Places / Distance Matrix (address autocomplete + travel fee)
# GOOGLE_MAPS_API_KEY=
# Twilio (SMS confirmations/reminders)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Resend (transactional email)
# RESEND_API_KEY=
