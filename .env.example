# Copy to .env.local and fill in. All free-tier services.

# --- Supabase (free tier) -------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin access ---------------------------------------------------------
# Comma-separated allowlist of operator emails that may sign in to /admin.
# Empty = nobody has admin access (fail closed).
ADMIN_EMAILS=brandolopz@gmail.com

# --- Booking approval SMS (free — textbee.dev) -----------------------------
# Install the textbee app (https://textbee.dev) on an Android phone that
# stays on and connected — that phone sends every text this app sends, using
# its own carrier plan. Link the device in the textbee dashboard for the key.
TEXTBEE_API_KEY=
# The operator's phone (E.164, e.g. +12149913908) — where new-booking
# approve/decline requests get texted.
OPERATOR_PHONE=

# --- Apple/iCloud Calendar sync (optional) --------------------------------
# Blocks booking slots during personal calendar events too, not just
# confirmed jobs. Generate an app-specific password at appleid.apple.com →
# Sign-In and Security → App-Specific Passwords (don't use the real Apple ID
# password). Leave both unset to skip calendar sync entirely.
APPLE_ICLOUD_USERNAME=
APPLE_ICLOUD_APP_PASSWORD=
# Optional: limit sync to one named calendar (as it appears in the Calendar
# app). Unset = every calendar on the account counts as busy time.
# APPLE_ICLOUD_CALENDAR_NAME=

# --- Phase 1 integrations (optional until wired) --------------------------
# Google Places / Distance Matrix (address autocomplete + travel fee)
# GOOGLE_MAPS_API_KEY=
# Resend (transactional email)
# RESEND_API_KEY=
